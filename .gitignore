# ── Entornos virtuales ────────────────────────────────────────────────
venv/
.venv/
env/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Secretos ──────────────────────────────────────────────────────────
.env
.env.*

# ── Modelos (pesos, embeddings, Modelfile generado) ───────────────────
models/
modelos/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
jarvis_ia/Modelfile
